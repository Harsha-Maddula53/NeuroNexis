# Database (Supabase / Postgres)
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Auth (NextAuth)
NEXTAUTH_SECRET="generate-a-secure-secret-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# AI (Groq)
GROQ_API_KEY="your-groq-api-key-here"

# Rate Limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL="https://[YOUR-UPSTASH-URL].upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# Error Tracking (Sentry)
NEXT_PUBLIC_SENTRY_DSN="your-sentry-dsn"
SENTRY_AUTH_TOKEN="your-sentry-auth-token"
SENTRY_ORG="your-sentry-org"
SENTRY_PROJECT="your-sentry-project"

# Password reset emails
# Production / any deployed environment: RESEND_API_KEY must be set or real users will not receive mail.
# Local fallback is Ethereal (disposable catch-all). It does NOT deliver to real inboxes.
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="NeuroNexis <onboarding@resend.dev>"

# Supabase (optional frontend usage)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key-here"
